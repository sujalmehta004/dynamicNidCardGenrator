# ==============================================================================
# National Identity Card Management Hub & QR Routing Gateway - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Database Connection (Required)
# ------------------------------------------------------------------------------
# Used for storing citizen identity profiles (Person model), allowed IP addresses
# (AllowedIp model), allowed devices (AllowedComputer model), and system configurations.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Secondary Database Connection (Required for Voter List Storage)
# ------------------------------------------------------------------------------
# Dedicated MongoDB database used for caching and persisting election voterlist
# records, portraits (base64 image blobs), and verification sync statuses
# (VoterListRecord model).
MONGODB_URI_SECOND=mongodb+srv://<username>:<password>@<secondary-cluster-url>/<database-name>?retryWrites=true&w=majority
